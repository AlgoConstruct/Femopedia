# Development defaults for docker-compose.yml. Copy to .env (git-ignored)
# before running `docker compose up`. These must agree with
# backend/.env.example's DATABASE_URL and NEO4J_PASSWORD, or a fresh clone's
# Django app will not be able to reach these same containers.
POSTGRES_USER=femopedia
POSTGRES_PASSWORD=femopedia
NEO4J_PASSWORD=femopedia-dev-password
